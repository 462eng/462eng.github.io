+	 */
+	for (int ms = 0; ms < 2000; ms += 50) {
+		bool all_done = true;
+		wl_display_roundtrip(w->display);
+		for (struct direct_wayland_lease_device *d = w->devices; d; d = d->next) {
+			all_done = all_done && d->done;
+		}
+		if (all_done) {
+			break;
+		}
+		os_nanosleep(50 * U_TIME_1MS_IN_NS);
+	}
+
 	while (dev) {
 		if (!dev->done) {
-			wl_display_dispatch(w->display);
+			COMP_WARN(w->base.base.c, "Ignoring DRM lease device that never sent done (stale global?)");
+			dev = dev->next;
+			continue;
+		}
+		// mutter may keep stale lease devices of removed GPUs that advertise
+		// the connectors of the real one: allow pinning the DRM node.
+		const char *node = debug_get_option_requested_drm_node();
+		if (node && (!dev->path || strcmp(node, dev->path) != 0)) {
+			COMP_WARN(w->base.base.c, "Skipping DRM lease device %s (XRT_COMPOSITOR_WAYLAND_DRM_NODE=%s)",
+			          dev->path ? dev->path : "?", node);
+			dev = dev->next;
 			continue;
 		}
